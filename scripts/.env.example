# Development, CLI, evaluation and test environment
# Copy to scripts/.env; local values and credentials must not be committed.
# Public script entry points load this file as dotenv data, never Shell code.
# Existing process environment values, including empty values, take precedence.
# Go/npm commands run directly do not automatically load this file.

# -----------------------------------------------------------------------------
# Frontend and development launcher
# -----------------------------------------------------------------------------
# scripts/dev.sh imports only these three values; API_PORT overrides API PORT.
API_PORT=8080
WEB_PORT=3000
# Empty follows API_PORT. Set an explicit URL only for a separate API endpoint.
NEXT_PUBLIC_API_BASE_URL=
# The browser runner explicitly overrides this normal Next.js output directory.
AGENTFLOW_TEST_DIST_DIR=.next

# -----------------------------------------------------------------------------
# Headless Run client
# -----------------------------------------------------------------------------
# scripts/agentflow.sh imports only these values; CLI flags take precedence.
AGENTFLOW_API_URL=http://localhost:8080
# Empty omits a full frontend Replay link; workspace/session depend on the user.
AGENTFLOW_WEB_URL=
AGENTFLOW_WORKSPACE_ID=
AGENTFLOW_SESSION_FILE=

# -----------------------------------------------------------------------------
# Evaluation and demo scripts
# -----------------------------------------------------------------------------
# Live model calls require explicit flags. Never load the API's .env into tests.
OPENAI_API_KEY=
# Cross-encoder evaluations can use a separate credential from the API service.
RERANKER_API_KEY=
# Empty report paths use the owning script's repository-derived defaults.
EVALUATION_REPORT_DIR=
BENCHMARK_REPORT_DIR=
LIVE_BENCHMARK_DIR=
LOAD_REPORT_DIR=
DEMO_MODE=online
API_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
# Wrapper and direct Go load-test durations respectively; supported range 250ms..5m.
SOAK_DURATION=2s
LOAD_SOAK_DURATION=2s

# llama.cpp compatibility and tokenizer evidence scripts
LLAMA_CPP_BASE_URL=http://127.0.0.1:18081/v1
# Also named by the optional API route. The two local files do not share secrets.
LLAMA_CPP_API_KEY=local
LLAMA_CPP_ROUTE_ID=llama-cpp
LLAMA_CPP_REQUEST_TIMEOUT=3m
LLAMA_CPP_CALIBRATION_TIMEOUT=2m
LLAMA_CPP_TOOL_CALLING=false
LLAMA_CPP_STRUCTURED_OUTPUT=true
# Required deployment facts have no invented default; set before running evidence.
LLAMA_CPP_MODEL=
LLAMA_CPP_MODEL_ARTIFACT=
LLAMA_CPP_QUANTIZATION=
LLAMA_CPP_CONTEXT_WINDOW_TOKENS=
LLAMA_CPP_MAX_OUTPUT_TOKENS=
LLAMA_CPP_OUTPUT_RESERVE_TOKENS=
LLAMA_CPP_SAFETY_MARGIN_TOKENS=
LLAMA_CPP_HARDWARE=
# Empty version/hash values use script discovery when available.
LLAMA_CPP_BACKEND_VERSION=
LLAMA_CPP_GGUF_SHA256=
LLAMA_CPP_REPORT_DIR=
LLAMA_CPP_CALIBRATION_REPORT_DIR=
# Optional Run checks against an existing AgentFlow API; IDs must be authorized.
AGENTFLOW_BASE_URL=
AGENTFLOW_AGENT_ID=

# -----------------------------------------------------------------------------
# Integration and opt-in live tests (disabled by default)
# -----------------------------------------------------------------------------
# Never point tests at the application database. Required tests need CREATEDB.
TEST_DATABASE_URL=
TEST_OTLP_ENDPOINT=
TEST_JAEGER_URL=
TEST_VERCEL_SKILL_PROJECT=
AGENTFLOW_TEST_TOOLS_CONFIG=
KEYCLOAK_TEST_IMAGE=quay.io/keycloak/keycloak:26.7.5
# Credentials alone do not enable live gates. Business Tool credentials such as
# TAVILY_API_KEY must be explicitly supplied in the test process environment.
MCP_LIVE_TEST=0
MCP_EVIDENCE_PATH=
TAVILY_LIVE_TEST=0
AGENTFLOW_SANDBOX_TEST=0
SANDBOX_TEST_EVIDENCE_PATH=
# Browser fixture profiles; scripts/Playwright set the selected ones to 1.
AGENTFLOW_BROWSER_TEST=0
AGENTFLOW_IDENTITY_TEST=0
AGENTFLOW_KEYCLOAK_TEST=0
AGENTFLOW_EXECUTION_BOUNDARY_TEST=0
AGENTFLOW_FILESYSTEM_TEST=0
AGENTFLOW_FILESYSTEM_WRITE_TEST=0
AGENTFLOW_PLANNING_TEST=0
AGENTFLOW_PROJECT_GUIDANCE_TEST=0
AGENTFLOW_INBOX_EDGE_TEST=0
AGENTFLOW_MCP_TEST=0
AGENTFLOW_MCP_CONNECTION_TEST=0
AGENTFLOW_OWNER_ADMISSION_TEST=0
AGENTFLOW_PROMPT_SECURITY_TEST=0
AGENTFLOW_REASONING_TEST=0
AGENTFLOW_RERANKER_TEST=0
AGENTFLOW_SANDBOX_BROWSER_TEST=0
AGENTFLOW_SKILL_POLICY_TEST=0
AGENTFLOW_STRUCTURED_OUTPUT_TEST=0
AGENTFLOW_TOOL_DISCOVERY_TEST=0
AGENTFLOW_USAGE_TEST=0

# Release drill: empty database falls back to TEST_DATABASE_URL; empty report path
# uses the script's repository-derived default. The wrapper supplies REPO_ROOT.
RELEASE_DRILL_DATABASE_URL=
RELEASE_DRILL_REPORT_PATH=
RELEASE_DRILL_REPO_ROOT=
