{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentflow:schema:rag-golden-dataset:v1",
  "title": "AgentFlow RAG Golden Dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "cases"],
  "properties": {
    "schema_version": {
      "const": "rag-golden-dataset-v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "$ref": "#/$defs/tags"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "source_uri": {
          "type": "string",
          "minLength": 1
        },
        "content_contains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "anyOf": [
        { "required": ["document_id"] },
        { "required": ["chunk_id"] },
        { "required": ["source_uri"] },
        { "required": ["content_contains"] }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "query", "answerable"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "answerable": {
          "type": "boolean"
        },
        "expected_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "forbidden_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "min_acceptable_rank": {
          "type": "integer",
          "minimum": 1
        },
        "tags": {
          "$ref": "#/$defs/tags"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "answerable": { "const": true }
            },
            "required": ["answerable"]
          },
          "then": {
            "required": ["expected_sources"],
            "properties": {
              "expected_sources": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "expected_sources": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
