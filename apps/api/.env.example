# Server
BIND_ADDRESS=127.0.0.1
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
# Workspace isolation is always active. Requests without X-Workspace-ID use
# the current owner's active default Workspace, never a global namespace.

# OpenTelemetry traces (opt-in; metadata only, never prompt/reasoning/tool bodies)
# none disables the SDK and worker; otlp sends protobuf over HTTP to /v1/traces.
# Start deploy/observability/compose.yaml for a local Collector and Jaeger UI.
OTEL_TRACES_EXPORTER=none
# Operator-trusted origin only. HTTPS required except localhost/loopback.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=agentflow-api
# Whole-trace probability: 0=sample nothing, 1=all execution segments.
# AgentFlow fixes a parent-based ratio sampler; other OTEL sampler/header envs
# are not supported. Request Capture does not enable telemetry body capture.
OTEL_TRACES_SAMPLER_ARG=1

# Identity and Workspace membership
# local uses a persistent reserved local owner; it is NOT authenticated access.
# oidc requires provider URLs and Postgres. Passwords stay at the IdP.
# HTTPS is required except on loopback. Frontend/API must use the same hostname
# and scheme (ports may differ); ALLOWED_ORIGINS must include AUTH_WEB_URL.
AUTH_MODE=local
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/api/auth/callback
AUTH_WEB_URL=http://localhost:3000
# OIDC login automatically grants one personal Workspace after identity verification.
# Registration availability is controlled by the IdP (e.g. Keycloak User registration).
# Absolute TTL, 1m..24h; also capped by the provider ID token's expiry.
AUTH_SESSION_TTL=8h

# Chat models (OpenAI-compatible APIs)
# This secret-free JSON file is the complete peer LLM catalog, including each
# route's endpoint, model, timeout, capabilities, limits, priority, and pricing.
# Credential values remain in the process environment under the names referenced
# by the Catalog; they must never be placed in JSON.
MODEL_ROUTE_CONFIG_PATH=config/model-routes.json
PROVIDER_A_API_KEY=
PROVIDER_B_API_KEY=

# Embeddings
# The default endpoint uses local Ollama. Dimensions must match the Postgres
# vector schema. This singleton is independent from Chat model routing.
# Set EMBEDDING_API_KEY only when the embedding endpoint requires a credential.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434/api/embed
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSIONS=1536
EMBEDDING_REQUEST_TIMEOUT=5m

# Knowledge reranking (independent from Chat model routes and Run token budgets)
# heuristic preserves the local default; tei explicitly sends the normalized
# query and scoped chunk text to an operator-trusted TEI /rerank service.
# TEI requires an HTTP(S) origin, model ID and pinned deployment revision.
# Remote origins require HTTPS; explicit loopback/private IP origins allow HTTP.
RERANKER_MODE=heuristic
RERANKER_BASE_URL=
RERANKER_MODEL=
RERANKER_REVISION=
# Per HTTP batch, including body read. No retries or heuristic fallback.
RERANKER_TIMEOUT=3s
# Physical rerank requests in flight per process; excess requests fail immediately.
# This is separate from MAX_CONCURRENT_MODEL_REQUESTS (Chat/embedding traffic).
RERANKER_MAX_CONCURRENT_REQUESTS=2
# Optional Bearer token; never stored in reranker identity or evaluation reports.
RERANKER_API_KEY=

# Curated semantic memory
# off: explicit rule signals only; shadow: audit model proposals without
# committing them; auto: commit proposals that pass deterministic policy and
# the confidence threshold. Adaptive extraction uses the current Run's selected
# Chat LLM and is disabled when no Chat route has a credential.
MEMORY_ADAPTIVE_EXTRACTION_MODE=shadow
MEMORY_ADAPTIVE_MIN_CONFIDENCE=0.85
# Completed turns enter a bounded, non-blocking sync queue. A single worker
# preserves accepted order. Provider retries cover transient embed/store errors;
# max attempts includes the initial call.
MEMORY_SYNC_QUEUE_SIZE=256
MEMORY_SYNC_JOB_TIMEOUT=30s
MEMORY_PROVIDER_MAX_ATTEMPTS=3
MEMORY_PROVIDER_RETRY_BASE_DELAY=100ms

# Run concurrency: active agent runs and the additional waiting queue.
MAX_CONCURRENT_RUNS=8
RUN_QUEUE_SIZE=32
RUN_QUEUE_WAIT_TIMEOUT=30s

# Model request concurrency
# Maximum in-flight model HTTP requests across Chat and Embeddings. A streaming
# request holds one slot until its response body closes.
MAX_CONCURRENT_MODEL_REQUESTS=8
# One verified owner shares this smaller capacity across all of their Workspaces.
# Owner reservations also cover downstream key/global waits; streams hold one
# until body cleanup. Must be positive and below the global cap (global >= 2).
MAX_CONCURRENT_OWNER_MODEL_REQUESTS=2
# Additional pending physical attempts per owner, not Runs; 0 rejects excess immediately.
OWNER_MODEL_QUEUE_SIZE=8
# Owner-slot wait only; a shorter route/Embedding timeout still wins.
OWNER_MODEL_QUEUE_WAIT_TIMEOUT=30s
# Per-API-key token buckets. Set either value to 0 to disable that limit.
MODEL_REQUESTS_PER_MINUTE=60
MODEL_TOKENS_PER_MINUTE=120000

# Retry transient model failures only. Max attempts includes the initial call;
# max delay also caps provider Retry-After values.
MODEL_RETRY_MAX_ATTEMPTS=3
MODEL_RETRY_BASE_DELAY=500ms
MODEL_RETRY_MAX_DELAY=5s

# Model request reconstruction and context capture
# Every run-scoped physical model attempt persists a secret-free envelope and
# exact transport payload hash. metadata_only stores no prompt content;
# redacted stores bounded canonical JSON after deterministic secret redaction;
# full stores exact canonical JSON only when no credential-like content is
# detected; otherwise the capture is automatically downgraded to redacted.
MODEL_REQUEST_CAPTURE_MODE=metadata_only
MODEL_REQUEST_CAPTURE_MAX_BYTES=262144
# Redacted/full payload content is purged lazily after this duration; envelopes and hashes remain.
MODEL_REQUEST_CAPTURE_RETENTION=168h

# Per-Run resource budget
# These limits are frozen into new Runs. Set a value to 0 to disable that
# dimension. Model calls count logical calls; provider retry attempts do not
# add Run model calls, but still consume the request-level RPM/TPM limits above.
RUN_MAX_MODEL_CALLS=32
RUN_MAX_PROMPT_TOKENS=200000
RUN_MAX_COMPLETION_TOKENS=50000
RUN_MAX_TOTAL_TOKENS=250000
RUN_MAX_TOOL_CALLS=50
# Active execution only. Time in waiting_for_user is excluded.
RUN_MAX_RUNTIME=15m
# Cost values are USD. Cost enforcement remains disabled while the maximum is 0.
RUN_MAX_ESTIMATED_COST_USD=0
MODEL_INPUT_COST_PER_MILLION_TOKENS_USD=0
MODEL_OUTPUT_COST_PER_MILLION_TOKENS_USD=0

# Context assembly
# Input budget = model context window - output reserve - safety margin.
# Source caps limit optional content; required system/input/tool protocol is never silently dropped.
MODEL_CONTEXT_WINDOW_TOKENS=128000
MODEL_OUTPUT_RESERVE_TOKENS=8192
CONTEXT_SAFETY_MARGIN_TOKENS=4096
CONTEXT_HISTORY_MAX_TOKENS=64000
CONTEXT_MEMORY_MAX_TOKENS=8000
CONTEXT_KNOWLEDGE_MAX_TOKENS=16000
# Deterministically preserve the head and tail of oversized tool results.
CONTEXT_TOOL_RESULT_MAX_TOKENS=2000

# Source-aware session history retrieval
# Before each model call, AgentFlow may recover exact Messages and execution
# Events from the durable conversation log when they match the current input.
# These are per-call hard caps; WINDOW is the adjacent source count per side.
CONTEXT_HISTORY_RETRIEVAL_MAX_RESULTS=8
CONTEXT_HISTORY_RETRIEVAL_MAX_CHARACTERS=12000
CONTEXT_HISTORY_RETRIEVAL_MAX_TOKENS=3000
CONTEXT_HISTORY_RETRIEVAL_WINDOW=1

# Context compaction
# Soft compaction runs asynchronously after a completed run. Hard compaction is
# attempted before a request; failures retain original messages and fall back to
# recent-history selection. Thresholds apply to the available model input budget.
# SUMMARY_MAX_TOKENS is a hard ceiling; the actual target scales with eligible
# source size. Provider-overflow recovery retries a text call only after the
# durable compaction generation advances.
CONTEXT_COMPACTION_MODE=auto
CONTEXT_COMPACTION_SOFT_THRESHOLD=0.70
CONTEXT_COMPACTION_HARD_THRESHOLD=0.85
CONTEXT_COMPACTION_RECENT_TOKENS=16000
CONTEXT_COMPACTION_SUMMARY_MAX_TOKENS=2000
CONTEXT_COMPACTION_TIMEOUT=45s

# Agent runtime
# ROUTER_MODE supports auto or query_match.
# Iterations and output characters are Autonomous loop guards. Runtime and tool
# values are mode-specific caps folded once into the frozen Run Budget; they do
# not create a second runtime/tool counter for new Runs.
ROUTER_MODE=auto
AUTONOMOUS_MAX_ITERATIONS=5
AUTONOMOUS_MAX_RUNTIME_SECONDS=300
AUTONOMOUS_MAX_OUTPUT_CHARS=60000
AUTONOMOUS_MAX_TOOL_CALLS=20
# Running runs older than this threshold are marked recoverable at startup.
RECOVERY_STALE_RUN_TIMEOUT=60s

# Persistence
# Required: PostgreSQL is the only application persistence backend; no fallback.
DATABASE_URL=postgres://agentflow:agentflow@localhost:5432/agentflow?sslmode=disable

# Tool catalog state
TOOL_CONFIG_PATH=.data/tools.json

# Operator-trusted installation roots (CSV); discover immediate SKILL.md packages.
# Install with npx skills from the repository root into .agents/skills, then review.
# Empty disables new bindings. No recursive repository scanning or script execution.
# Relative paths resolve from the API process working directory (normally apps/api).
TRUSTED_SKILL_DIRS=../../.agents/skills
# Tavily credential for the built-in web_search Tool, enabled by default.
# Leave empty to withhold its logical credential grant; Tool enablement alone
# does not grant network access. Existing custom Tool policies need an exact rule.
# Keep the real value in the process environment or local, ignored .env only.
TAVILY_API_KEY=

# Disposable command sandboxes (local Docker sbx, NOT host execution)
# Requires compatible --skills off support, sbx login and a local daemon. Also enable
# sandbox_command in Tools and add its explicit security rule (see sandbox docs).
SANDBOX_ENABLED=false
SANDBOX_EXECUTABLE=sbx
# Private 0700 directory; keep across restarts for orphan cleanup. One API owner.
SANDBOX_STATE_DIRECTORY=.data/sandboxes
# Prefer an immutable image digest for repeatable experiments; template is trusted.
SANDBOX_TEMPLATE=docker.io/docker/sandbox-templates:shell
# Guest executable paths only; argv cannot choose mounts, env, network or sbx flags.
SANDBOX_ALLOWED_COMMANDS=/bin/sh,/usr/bin/python3
# Per-VM CPU/RAM, then process-wide concurrent VMs (not model request concurrency).
SANDBOX_CPUS=1
SANDBOX_MEMORY_MIB=1024
SANDBOX_MAX_CONCURRENT=1
# Creation + execution, excluding bounded independent cleanup; guest files vanish.
SANDBOX_TIMEOUT=2m
# Retained combined stdout/stderr; larger results also use Tool Artifact governance.
SANDBOX_MAX_OUTPUT_BYTES=65536

# Tool result artifact governance
# A Tool Call keeps its descriptor-level result cap. In addition, one Tool-call
# batch is capped here; overflow is redacted and persisted as an immutable
# Artifact. The model receives only PREVIEW_BYTES plus an opaque retrieval ID.
TOOL_RESULT_MAX_BATCH_BYTES=8000
TOOL_ARTIFACT_MAX_BYTES=5242880
TOOL_ARTIFACT_PREVIEW_BYTES=1000
# Expiry is persisted with Artifact metadata and survives server restarts.
TOOL_ARTIFACT_RETENTION=168h

# Tool Progress Guard
# These thresholds are frozen into each new Run. The second identical typed
# failure or read-only result warns the model; the fourth matching attempt is
# blocked before Budget/handler execution; a fifth attempt halts the Turn.
# Disable only for controlled diagnostics. Writes are never classified by
# repeated result content, and their successful completion resets the pattern.
TOOL_PROGRESS_GUARD_ENABLED=true
TOOL_PROGRESS_WARN_AFTER=2
TOOL_PROGRESS_BLOCK_AFTER=4
TOOL_PROGRESS_HALT_AFTER=5

# Completion verification
# Host command verification is restricted to trusted AUTH_MODE=local, Linux/macOS.
# Requires a root and an absolute executable allowlist; OIDC always blocks it
# until an isolated runner exists. Clean child environment, supervised process
# group, canonical cwd checks. This is NOT a filesystem/network/CPU sandbox.
VERIFICATION_WORKSPACE_ROOT=
VERIFICATION_ALLOWED_COMMANDS=
# Default deny, INCLUDING loopback. Comma-separated exact origins, e.g.
# https://example.com,http://127.0.0.1:8080 (grant only trusted read-only services).
# Bare public hostnames mean HTTPS:443; host:port alone is not supported.
# DNS names must resolve entirely to public IPs; explicit localhost/literal
# private origins opt into those targets. Link-local metadata targets are denied.
# No redirects/environment proxies; response consumption <=1 MiB, total <=10s.
VERIFICATION_ALLOWED_HTTP_HOSTS=
# Raw verifier output is hashed and capped before persistence.
VERIFICATION_MAX_ARTIFACT_BYTES=65536
